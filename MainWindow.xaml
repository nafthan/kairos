<Window x:Class="Kairos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kairos"
        Title="Kairos"
        Icon="Kairos.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MinWidth="200" MinHeight="110"
        Width="380" Height="260"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root">

        <!-- Background image or album art (when chosen), drawn behind everything -->
        <local:BackgroundLayer x:Name="Bg"/>

        <!-- Window background (colour, opacity and corner radius come from settings) -->
        <Border x:Name="Frame" CornerRadius="12" Background="#D9121212" Padding="16">
            <Grid x:Name="ContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- An optional panel (and border) behind the lyrics: settings → Layout -->
                <Border x:Name="LyricsPanel" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Song title and artist -->
                <!-- The text spans the full width (with equal space reserved on both sides when the cover shows),
                     so centred titles line up with the centred lyrics. -->
                <Grid x:Name="TrackInfoPanel" Grid.Row="0" Margin="0,0,0,8" MinHeight="42">
                    <Border x:Name="ArtThumb" Width="42" Height="42" CornerRadius="6" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                        </Border.Effect>
                    </Border>
                    <!-- Your profile picture (settings → Layout), on the right in the standard layout -->
                    <Border x:Name="ProfileThumb" Width="42" Height="42" CornerRadius="21" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                        </Border.Effect>
                    </Border>
                <StackPanel x:Name="TrackText" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="TrackTitle" FontWeight="SemiBold" FontSize="13" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TrackArtist" FontSize="11.5" Foreground="White" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <TextBlock x:Name="SyncNote" FontSize="10.5" Foreground="White" Opacity="0.45"
                               Text="Not time-synced for this song" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
                </Grid>

                <!-- The lyrics. Top/bottom edges fade out so lines don't end abruptly. -->
                <ScrollViewer x:Name="Scroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Focusable="False"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.14"/>
                            <GradientStop Color="Black" Offset="0.86"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <StackPanel x:Name="LinesHost">
                        <Border x:Name="TopSpacer" Height="0"/>
                        <StackPanel x:Name="LinesPanel"/>
                        <Border x:Name="BottomSpacer" Height="0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Cover and profile picture placed anywhere (custom layouts) -->
                <Border x:Name="FreeArt" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.45"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="FreeProfile" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.45"/>
                    </Border.Effect>
                </Border>

                <!-- Status messages: "Play a song in Spotify", "Finding lyrics…", etc. -->
                <StackPanel x:Name="StatusPanel" Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                    <TextBlock x:Name="StatusText" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusSubText" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                               Foreground="White" Opacity="0.55" FontSize="12" Margin="0,4,0,0"/>
                    <StackPanel x:Name="NoLyricsButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="AddLyricsButton" Style="{StaticResource PillButton}" Content="Add lyrics"
                                Click="AddLyricsButton_Click"/>
                        <Button x:Name="NoLyricsButton" Style="{StaticResource PillGhostButton}" Content="This song has no lyrics"
                                Margin="8,0,0,0" Click="NoLyricsButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls that appear when the mouse is over the window -->
        <Border x:Name="HoverBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,8,0" Padding="3" CornerRadius="16" Background="#B3000000" Opacity="0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="PrevButton" Content="&#xE892;" ToolTip="Previous" Click="PrevButton_Click"/>
                <Button x:Name="PlayPauseButton" Content="&#xE768;" ToolTip="Play / pause" Click="PlayPauseButton_Click"/>
                <Button x:Name="NextButton" Content="&#xE893;" ToolTip="Next" Click="NextButton_Click"/>
                <Border Width="1" Margin="4,5" Background="#40FFFFFF"/>
                <Button x:Name="SearchButton" Content="&#xE721;" ToolTip="Search Spotify (Ctrl+F)" Click="SearchButton_Click" Visibility="Collapsed"/>
                <Button x:Name="AddToPlaylistButton" Content="&#xE710;" ToolTip="Add to playlist" Click="AddToPlaylistButton_Click" Visibility="Collapsed"/>
                <Button x:Name="PlaylistsButton" Content="&#xE8FD;" ToolTip="Playlists" Click="PlaylistsButton_Click" Visibility="Collapsed"/>
                <Button x:Name="MiniButton" Content="&#xE73F;" ToolTip="Mini mode (Ctrl+Alt+M)" Click="MiniButton_Click"/>
                <Button x:Name="VolumeButton" Content="&#xE767;" ToolTip="Spotify volume (or Ctrl + scroll)" Click="VolumeButton_Click"/>
                <Button x:Name="MoreButton" Content="&#xE712;" ToolTip="Settings" Click="MoreButton_Click"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Optional playback timing readout (right-click → Show timing info) -->
        <Border x:Name="TimingPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,30,10"
                Padding="8,5" CornerRadius="6" Background="#D9000000" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TimingText" Foreground="#FFE0E0E0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- Shown after scrolling away from the current line -->
        <Button x:Name="BackButton" Style="{StaticResource PillButton}"
                Content="Back to current line"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                Visibility="Collapsed" Click="BackButton_Click"/>

        <!-- Brief messages, e.g. "Lyrics 0.25 s earlier" -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Padding="10,5" CornerRadius="10" Background="#E6202020" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Bottom-right resize handle -->
        <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,3,3" Cursor="SizeNWSE" Opacity="0" DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 15,4 L 4,15 M 15,9 L 9,15 M 15,14 L 14,15" Stroke="#B3FFFFFF"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
