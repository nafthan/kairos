<Window x:Class="Kairos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kairos"
        Title="Kairos Settings"
        Width="800" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="Kairos.ico"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">


    <Grid Margin="16">
        <!-- Shadow lives on its own layer so it doesn't soften the text -->
        <Border CornerRadius="14" Background="{StaticResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Sidebar ===== -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="13,0,0,13"
                        MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,22">
                            <!-- The logo drawn as shapes, so it stays sharp at any size and display scaling -->
                            <Viewbox Width="30" Height="30" SnapsToDevicePixels="True">
                                <Canvas Width="100" Height="100">
                                    <Rectangle Width="100" Height="100" RadiusX="22.5" RadiusY="22.5">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#202023" Offset="0"/>
                                                <GradientStop Color="#0A0A0C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Path Fill="#1ED760" Data="M26,58 A24,24 0 0 1 74,58 Z"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="56.5" Width="68" Height="11" RadiusX="5.5" RadiusY="5.5" Fill="#F2F2F2"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Kairos" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Settings" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="VersionButton" DockPanel.Dock="Bottom" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Left" Margin="12,0,0,14" FontSize="11.5"
                                ToolTip="See what's changed in each version" Click="VersionButton_Click"/>
                        <!-- Scrolls if the window is short (the scroll bar stays hidden; the mouse wheel works) -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="Nav" Margin="10,0,10,8"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Main area ===== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                        <StackPanel Margin="28,22,0,0">
                            <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="PageSubtitle" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Click="Done_Click"/>
                    </Grid>

                    <!-- Live preview -->
                    <Border x:Name="PreviewPanel" Grid.Row="1" Margin="28,16,28,4" Height="210" CornerRadius="12" ClipToBounds="True">
                        <Border.Background>
                            <!-- a stand-in "desktop" so background opacity is easy to judge -->
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B3A67" Offset="0"/>
                                <GradientStop Color="#5B3A70" Offset="0.55"/>
                                <GradientStop Color="#A0526D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="LIVE PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="#80FFFFFF"
                                       Margin="12,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <!-- A miniature of your lyrics window, playing a sample song (filled in from code) -->
                            <ContentControl x:Name="PreviewHost" Margin="16,26,16,14" Focusable="False"/>
                        </Grid>
                    </Border>

                    <!-- Page content -->
                    <ScrollViewer x:Name="PageScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,8,6,0" Focusable="False">
                        <StackPanel x:Name="PageHost" Margin="28,4,22,16"/>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel Margin="20,12,20,14" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Style="{StaticResource TextButton}" Content="Reset to defaults" Click="Reset_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Done" Click="Done_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Undo changes"
                                    Margin="0,0,10,0" Click="Undo_Click"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- Resize from the right edge, the bottom edge or the corner -->
        <Thumb Style="{StaticResource ResizeEdge}" HorizontalAlignment="Right" Width="8" Margin="0,40,-4,40"
               Cursor="SizeWE" DragDelta="ResizeRight_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <Thumb Style="{StaticResource ResizeEdge}" VerticalAlignment="Bottom" Height="8" Margin="40,0,40,-4"
               Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <Thumb Style="{StaticResource ResizeCorner}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Width="18" Height="18" Margin="0,0,3,3" DragDelta="ResizeCorner_DragDelta" DragCompleted="Resize_DragCompleted"
               ToolTip="Drag to resize"/>
    </Grid>
</Window>
