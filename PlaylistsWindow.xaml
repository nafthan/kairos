<Window x:Class="Kairos.PlaylistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kairos – Playlists"
        Width="900" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="Kairos.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- One playlist in the sidebar -->
        <DataTemplate x:Key="PlaylistTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="6" Background="#2A2A2A" HorizontalAlignment="Left">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="40" Height="40" CornerRadius="6" Background="Black"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <Grid>
                        <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Liked Songs: the purple heart tile -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLikedSongs}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#450AF5" Offset="0"/>
                                    <GradientStop Color="#C4EFD9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One song in a playlist -->
        <DataTemplate x:Key="TrackTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" Foreground="{StaticResource FaintBrush}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <Image Grid.Column="1" Width="36" Height="36" Stretch="UniformToFill" HorizontalAlignment="Left"
                       Source="{Binding ImageUrl, TargetNullValue={x:Null}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Artists}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Shadow on its own layer so it doesn't soften the text -->
        <Border CornerRadius="14" Background="{StaticResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Sidebar: playlists ===== -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="13,0,0,13">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,20,12,12" Background="Transparent"
                              MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                            <StackPanel>
                                <TextBlock Text="Your playlists" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="AccountText" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LikedHint" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="To see Liked Songs, reconnect Spotify in settings (one extra permission)."/>
                            </StackPanel>
                            <Button Style="{StaticResource CloseButton}" Content="&#xE72C;" ToolTip="Refresh"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click"/>
                        </Grid>
                        <TextBox x:Name="PlaylistSearch" DockPanel.Dock="Top" Style="{StaticResource DarkText}"
                                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                                 Margin="14,0,14,10" TextChanged="PlaylistSearch_TextChanged"
                                 ToolTip="Filter playlists"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="14,4,14,14">
                            <Button x:Name="AddSharedToggle" Style="{StaticResource TextButton}" HorizontalAlignment="Left"
                                    Content="+  Add a shared playlist" Click="AddSharedToggle_Click"
                                    ToolTip="For playlists you collaborate on that don't show up here"/>
                            <StackPanel x:Name="AddSharedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="Paste the playlist's link (in Spotify: Share → Copy link to playlist)"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox x:Name="SharedLinkBox" Style="{StaticResource DarkText}" KeyDown="SharedLinkBox_KeyDown"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Add" Padding="18,6" Click="AddShared_Click"/>
                                    <Button Style="{StaticResource TextButton}" Content="Cancel" Margin="4,0,0,0" Click="AddSharedToggle_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="AddSharedStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="PlaylistList" Style="{StaticResource DarkList}"
                                 ItemContainerStyle="{StaticResource DarkListItem}"
                                 ItemTemplate="{StaticResource PlaylistTemplate}"
                                 Padding="8,0,4,8"
                                 SelectionChanged="PlaylistList_SelectionChanged"/>
                    </DockPanel>
                </Border>

                <!-- ===== Main: the selected playlist ===== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown" Margin="24,24,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeaderCover" Width="104" Height="104" CornerRadius="10" Background="#2A2A2A"/>
                        <StackPanel Grid.Column="1" Margin="18,0,40,0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="HeaderName" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HeaderSub" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="Play" Click="Play_Click"
                                        Margin="0,0,8,0" Visibility="Collapsed"/>
                                <Button x:Name="AddCurrentButton" Style="{StaticResource GhostButton}" Content="Add current song"
                                        Click="AddCurrent_Click" Visibility="Collapsed"/>
                                <Button x:Name="NoLyricsToggle" Style="{StaticResource TextButton}" Margin="8,0,0,0"
                                        Click="NoLyricsToggle_Click" Visibility="Collapsed"
                                        ToolTip="For playlists without singing: Kairos skips the lyrics search and shows your no-lyrics visual"/>
                                <Button x:Name="RemoveLinkButton" Style="{StaticResource TextButton}" Content="Remove from list"
                                        Margin="8,0,0,0" Click="RemoveLink_Click" Visibility="Collapsed"
                                        ToolTip="Stop showing this shared playlist in Kairos (it isn't deleted from Spotify)"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,0,0" Click="Close_Click"/>
                    </Grid>

                    <!-- Song filter -->
                    <TextBox x:Name="TrackSearch" Grid.Row="1" Style="{StaticResource DarkText}"
                             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                             Margin="24,8,24,10" TextChanged="TrackSearch_TextChanged" ToolTip="Filter songs"
                             Visibility="Collapsed"/>

                    <!-- Songs -->
                    <ListBox x:Name="TrackList" Grid.Row="2" Style="{StaticResource DarkList}"
                             ItemContainerStyle="{StaticResource DarkListItem}"
                             ItemTemplate="{StaticResource TrackTemplate}"
                             Padding="16,0,10,12"
                             MouseDoubleClick="TrackList_MouseDoubleClick"/>

                    <!-- Messages: loading, errors, "double-click to play" -->
                    <StackPanel x:Name="MessagePanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="40" IsHitTestVisible="False">
                        <TextBlock x:Name="MessageText" FontSize="15" Foreground="{StaticResource TextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageSub" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Toast -->
                    <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Padding="14,8" CornerRadius="10" Background="#F0242424" BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="420"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
